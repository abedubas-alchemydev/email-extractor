# Production env for extractor.alchemydev.io.
# Copy to /opt/extractor/.env on the VPS and fill in. NEVER commit the real .env.
# Generate each secret with:  openssl rand -hex 32
#
# Fixed per-deployment values (domain, CORS, public URL, cookie security) are
# baked into docker-compose.prod.yml — they are NOT read from here, so this file
# only carries secrets + optional provider keys.

# ---- Postgres (self-hosted in the stack; bound to 127.0.0.1:5434) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=email_extractor

# ---- BetterAuth ----
# Signs the session cookie (frontend) AND verifies it (backend). The SAME value
# is injected into both services by the compose file — set it once here.
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- Apollo async phone-reveal webhook (optional) ----
# Phone-reveal activates only when BOTH this and a funded APOLLO_API_KEY are set.
# Webhook URL Apollo calls back: https://extractor.alchemydev.io/api/v1/webhooks/apollo/<secret>/phone-reveal
APOLLO_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- Enrichment provider keys (optional; each provider is skipped until set) ----
APOLLO_API_KEY=
PDL_API_KEY=
SERPAPI_API_KEY=
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
