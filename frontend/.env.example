# =============================================================================
# Email Extractor frontend — environment template
# =============================================================================
# Copy to frontend/.env.local for local dev. Only NEXT_PUBLIC_* vars are
# embedded into the client bundle at build time. Never put secrets here.
# =============================================================================

# Base URL for the backend API. Leave EMPTY for same-origin: the browser then
# sends /api/v1/* to the page's own host so the BetterAuth session cookie rides
# along. In Docker dev, next.config.mjs proxies /api/v1/* to the backend; on the
# VPS, nginx terminates /api/v1/* before it reaches Next. Set a full URL only for
# a genuinely cross-origin backend (the cookie won't forward in that case).
NEXT_PUBLIC_API_BASE_URL=

# Public app origin — used by BetterAuth (server + client) to resolve the auth
# base URL and as a trusted origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only (NOT bundled into the client). Required for BetterAuth.
# -----------------------------------------------------------------------------

# node-postgres (pg) connection string for the BetterAuth adapter. Plain
# postgresql:// — no +psycopg suffix (that's backend SQLAlchemy-only).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_extractor

# Signs the BetterAuth session cookie. MUST match the backend's
# BETTER_AUTH_SECRET so FastAPI can validate the session HMAC. 32+ chars.
BETTER_AUTH_SECRET=change-me-to-a-32-plus-char-random-secret

# Canonical app URL BetterAuth issues cookies/redirects against. Usually the
# same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# Optional: extra comma-separated trusted origins for BetterAuth (e.g. a preview
# domain). NEXT_PUBLIC_APP_URL and http://127.0.0.1:3000 are always trusted.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Set to "production" on the VPS so BetterAuth issues Secure cookies.
# ENVIRONMENT=production
